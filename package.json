{
  "name": "agent-tracker",
  "displayName": "Agent Tracker",
  "description": "Claude와 Codex 구독 사용률 및 로컬 사용자 요청별 토큰 통계",
  "version": "0.1.0",
  "publisher": "agent-tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/lsc892/Agent-Tracker.git"
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.15.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/src/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests tools --max-warnings 0",
    "test": "npm run build && node tests/runners/run-tests.cjs",
    "test:vscode": "npm run build && node tests/runners/test-vscode.cjs",
    "test:toggle": "npm run build && node tests/vscode/statusbar-toggle.cjs",
    "patch:vscode": "node tools/vscode/statusbar-toggle.cjs",
    "restore:vscode": "node tools/vscode/statusbar-toggle.cjs --restore",
    "check": "npm run typecheck && npm run lint && npm test",
    "watch": "tsc -p tsconfig.json --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "benchmark": "npm run build && node tests/benchmarks/summary.cjs",
    "benchmark:quota": "npm run build && node tests/benchmarks/quota/benchmark.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "agentTracker.openDashboard",
        "title": "Agent Tracker: 대시보드 열기"
      },
      {
        "command": "agentTracker.openUsage",
        "title": "Agent Tracker: 사용 통계 열기"
      },
      {
        "command": "agentTracker.refreshQuota",
        "title": "Agent Tracker: 현재 사용량 새로고침",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTracker.openSettings",
        "title": "Agent Tracker: 설정 열기",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentTracker.configureStatusColor",
        "title": "Agent Tracker: 상태 표시줄 색상 선택"
      },
      {
        "command": "agentTracker.clearUsageData",
        "title": "Agent Tracker: 통계 계산 데이터 삭제"
      }
    ],
    "configuration": {
      "title": "Agent Tracker",
      "properties": {
        "agentTracker.display.percentage": {
          "type": "string",
          "enum": [
            "used",
            "remaining"
          ],
          "default": "used",
          "description": "사용률 또는 남은 비율을 표시합니다."
        },
        "agentTracker.display.detail": {
          "type": "string",
          "enum": [
            "compact",
            "detailed"
          ],
          "default": "detailed",
          "description": "상태 표시줄의 표시 방식입니다. 상세는 7일·5시간, 압축은 5시간 사용량만 표시합니다. 사용량 툴팁은 항상 모든 정보를 표시합니다."
        },
        "agentTracker.display.colorMode": {
          "type": "string",
          "enum": ["automatic", "white", "black", "custom"],
          "enumItemLabels": ["자동", "흰색", "검은색", "사용자 지정"],
          "enumDescriptions": [
            "현재 VS Code 테마와 작업공간의 상태 표시줄 기본 색상을 따릅니다.",
            "흰색으로 표시합니다.",
            "검은색으로 표시합니다.",
            "Display: Custom Color의 HEX 색상으로 표시합니다."
          ],
          "default": "automatic",
          "scope": "window",
          "order": 6,
          "markdownDescription": "사용량 항목의 로고·잔량 막대·글자와 새로고침 버튼 색상입니다. 자동은 2026 Dark·Light·고대비를 포함한 현재 테마의 기본 색상과 작업공간 색상 설정을 따릅니다. [색상 선택 열기](command:agentTracker.configureStatusColor)"
        },
        "agentTracker.display.customColor": {
          "type": "string",
          "default": "#ffffff",
          "format": "color-hex",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "patternErrorMessage": "#RGB, #RGBA, #RRGGBB 또는 #RRGGBBAA 형식으로 입력하세요.",
          "scope": "window",
          "order": 7,
          "markdownDescription": "사용자 지정 모드에서 사용할 HEX 색상입니다. 예: `#abc`, `#aabbcc`, `#ffffffcc`(투명도 포함). [색상 선택 열기](command:agentTracker.configureStatusColor)에서 색상 견본을 클릭하거나 HEX 값을 입력할 수 있습니다. 잘못된 값은 테마 기본 색상으로 표시합니다."
        },
        "agentTracker.codex.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Codex 상태 표시줄을 표시합니다. 숨겨도 quota 조회는 유지합니다."
        },
        "agentTracker.quota.pollingIntervalSeconds": {
          "type": "number",
          "minimum": 30,
          "default": 900,
          "order": 4,
          "markdownDescription": "자동 갱신 시 추적 중인 Claude Code와 Codex의 구독 사용량을 함께 조회하는 공통 간격(초)입니다. 기본 900초(15분), 최소 30초입니다. 수동 갱신 정책에서는 사용하지 않습니다."
        },
        "agentTracker.claude.dataHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Claude Code 데이터 홈. 비우면 CLAUDE_CONFIG_DIR 또는 ~/.claude를 사용합니다."
        },
        "agentTracker.codex.dataHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Codex 데이터 홈. 비우면 CODEX_HOME 또는 ~/.codex를 사용합니다."
        },
        "agentTracker.codex.executable": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Codex CLI 실행 파일 또는 PATH 명령입니다."
        },
        "agentTracker.usage.claudeRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Claude JSONL 루트 목록. 비우면 데이터 홈의 projects를 사용합니다."
        },
        "agentTracker.usage.codexRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Codex JSONL 루트 목록. 비우면 sessions와 archived_sessions를 사용합니다."
        },
        "agentTracker.usage.timezone": {
          "type": "string",
          "default": "",
          "description": "일·월 통계의 IANA 시간대. 비우면 시스템 시간대를 사용합니다."
        },
        "agentTracker.claude.enabled": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "Claude Code를 추적합니다. 끄면 사용량 조회와 원본 로그 수집을 중단하고 통계에서 숨깁니다. 기존 계산 데이터는 유지됩니다."
        },
        "agentTracker.codex.enabled": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "Codex를 추적합니다. 끄면 사용량 조회와 원본 로그 수집을 중단하고 통계에서 숨깁니다. 기존 계산 데이터는 유지됩니다."
        },
        "agentTracker.quota.refreshPolicy": {
          "type": "string",
          "enum": [
            "automatic",
            "manual"
          ],
          "default": "automatic",
          "order": 3,
          "enumItemLabels": [
            "자동 갱신",
            "수동 갱신"
          ],
          "enumDescriptions": [
            "활성 창에서 시작 시와 설정한 간격마다 갱신합니다. 창으로 돌아올 때 마지막 성공 조회가 5분 이상 지났거나 조회 오류가 있으면 다시 조회합니다.",
            "새로고침을 눌렀을 때만 조회합니다."
          ],
          "markdownDescription": "현재 구독 사용량의 갱신 정책입니다. 자동 갱신은 비활성 창에서 멈추며, 실패 시 재시도 간격을 늘립니다. 통계 계산은 사용량 통계를 열 때만 실행됩니다."
        },
        "agentTracker.usage.enabled": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "markdownDescription": "사용량 통계를 사용합니다. 끄면 진행 중인 수집을 중단하고 통계 화면을 닫습니다. 구독 사용량 조회에는 영향을 주지 않습니다.\n\n[통계 계산 데이터 삭제](command:agentTracker.clearUsageData): 저장된 파일 처리 정보와 집계 결과를 삭제합니다. 원본 대화 로그는 유지되며, 통계를 다시 열면 재계산합니다."
        }
      }
    },
    "icons": {
      "agent-tracker-codex": {
        "description": "Codex logo",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e001"
        }
      },
      "agent-tracker-claude": {
        "description": "Claude logo",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e002"
        }
      },
      "agent-tracker-quota-0": {
        "description": "0% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e010"
        }
      },
      "agent-tracker-quota-1": {
        "description": "10% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e011"
        }
      },
      "agent-tracker-quota-2": {
        "description": "20% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e012"
        }
      },
      "agent-tracker-quota-3": {
        "description": "30% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e013"
        }
      },
      "agent-tracker-quota-4": {
        "description": "40% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e014"
        }
      },
      "agent-tracker-quota-5": {
        "description": "50% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e015"
        }
      },
      "agent-tracker-quota-6": {
        "description": "60% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e016"
        }
      },
      "agent-tracker-quota-7": {
        "description": "70% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e017"
        }
      },
      "agent-tracker-quota-8": {
        "description": "80% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e018"
        }
      },
      "agent-tracker-quota-9": {
        "description": "90% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e019"
        }
      },
      "agent-tracker-quota-10": {
        "description": "100% remaining quota",
        "default": {
          "fontPath": "./resource/icon/agent-tracker.woff",
          "fontCharacter": "\\e01a"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
