      "stdin": [
        "const { readFileSync, mkdtempSync } = require('node:fs');",
        "const { createHash } = require('node:crypto');",
        "const { tmpdir } = require('node:os');",
        "const { join } = require('node:path');",
        "const [directory, input, algorithm] = process.argv.slice(2);",
        "const { SummaryDatabase } = require(join(directory, 'src/summary/db'));",
        "const { refreshSummary } = require(join(directory, 'src/summary/scanner'));",
        "const snapshot = JSON.parse(readFileSync(input, 'utf8'));",
        "const dbPath = join(mkdtempSync(join(tmpdir(), 'agent-tracker-full-refresh-')), 'summary.sqlite');",
        "const database = new SummaryDatabase(dbPath);",
        "async function measure() {",
        "  global.gc();",
        "  const memory = () => {",
        "    const { rss, heapUsed } = process.memoryUsage();",
        "    return { rss, heapUsed };",
        "  };",
        "  const startMemory = memory();",
        "  const peak = { ...startMemory };",
        "  const sample = () => {",
        "    const current = memory();",
        "    peak.rss = Math.max(peak.rss, current.rss);",
        "    peak.heapUsed = Math.max(peak.heapUsed, current.heapUsed);",
        "  };",
        "  const timer = setInterval(sample, 5);",
        "  let result;",
        "  try {",
        "    result = await refreshSummary(database, {",
        "      dbPath, roots: snapshot.roots, timezone: 'Asia/Seoul', sourceWorkers: 4, collectCapabilities: false,",
        "    }, undefined, sample);",
        "  } finally { clearInterval(timer); }",
        "  sample();",
        "  const peakRssBytes = process.resourceUsage().maxRSS * 1024;",
        "  const usageTable = database.connection.prepare('SELECT * FROM usage_request_daily').all();",
        "  const ordered = usageTable.map(row => JSON.stringify(row)).sort();",
        "  const usageSha256 = createHash('sha256').update(JSON.stringify(ordered)).digest('hex');",
        "  const usage = database.connection.prepare(",
        "    'SELECT provider, SUM(turn_count) AS threads, SUM(total_tokens) AS tokens FROM usage_request_daily GROUP BY provider ORDER BY provider',",
        "  ).all();",
        "  const { timings, parsed, failed, bodyBytes, interrupted } = result;",
        "  console.log(JSON.stringify({ algorithm, snapshotSha256: snapshot.sha256, peakRssBytes, observedRssBytes: peak.rss,",
        "    peakMainHeapBytes: peak.heapUsed, startMemory, parsed, failed, bodyBytes, interrupted, timings, usageSha256, usage }));",
        "}",
        "measure().catch(error => { process.stderr.write(String(error.code || error.name)); process.exitCode = 1; })",
        "  .finally(() => database.close());"
      ]
    }
  },
  "runner": {
    "arguments": [
      "compiled output directory containing src/",
      "private frozen input manifest",
      "group",
      "algorithm label"
    ],
    "stdin": [
      "const { readFileSync } = require('node:fs');",
      "const { lstat } = require('node:fs/promises');",
      "const { createHash } = require('node:crypto');",
      "const { cpus } = require('node:os');",
      "const { join, resolve, relative, isAbsolute, sep } = require('node:path');",
      "const [directory, input, group, label] = process.argv.slice(2);",
      "const jsonl = require(join(directory, 'src/summary/jsonl'));",
      "const { prepareSource } = require(join(directory, 'src/summary/scanner/sourcePreparation'));",
      "const snapshot = JSON.parse(readFileSync(input, 'utf8'));",
      "const digest = createHash('sha256');",
      "const files = snapshot.files.flatMap((entry, index) => {",
      "  const path = resolve(entry.path);",
      "  const root = snapshot.roots.find(root => {",
      "    const remainder = relative(root.path, path);",
      "    return remainder && !isAbsolute(remainder) && remainder !== '..' && !remainder.startsWith('..' + sep);",
      "  });",
      "  if (!root) throw new Error('Input outside frozen roots');",
      "  const kind = root.provider === 'claude' ? 'claude-plain' : path.toLowerCase().endsWith('.zst') ? 'codex-zstd' : 'codex-plain';",
      "  return group === kind ? [{ path, provider: root.provider, source_root: root.path, expectedBytes: entry.bytes, id: index + 1 }] : [];",
      "});",
      "async function measureFiles() {",
      "  let bodyBytes = 0, rows = 0, failed = 0, partial = 0, prepareMs = 0;",
      "  const errors = {};",
      "  const read = jsonl.readJsonl;",
      "  jsonl.readJsonl = async (...args) => {",
      "    const result = await read(...args);",
      "    rows += result.rows;",
      "    return result;",
      "  };",
      "  const ready = await Promise.all(files.map(async ({ expectedBytes, ...entry }) => {",
      "    const stat = await lstat(entry.path);",
      "    if (stat.size !== expectedBytes) throw new Error('Snapshot size differs');",
      "    return { ...entry, size_bytes: stat.size, mtime_ms: stat.mtimeMs };",
      "  }));",
      "  const start = process.memoryUsage();",
      "  const peak = { heapUsed: start.heapUsed, arrayBuffers: start.arrayBuffers };",
      "  const sample = () => {",
      "    const memory = process.memoryUsage();",
      "    peak.heapUsed = Math.max(peak.heapUsed, memory.heapUsed);",
      "    peak.arrayBuffers = Math.max(peak.arrayBuffers, memory.arrayBuffers);",
      "  };",
      "  const timer = setInterval(sample, 5);",
      "  try {",
      "    const options = { cancelled: () => false, onBytes: count => { bodyBytes += count; } };",
      "    for (const entry of ready) {",
      "      const started = performance.now();",
      "      const result = await prepareSource(entry, options);",
      "      prepareMs += performance.now() - started;",
      "      sample();",
      "      if (!result.ok) {",
      "        failed++;",
      "        errors[result.error.code] = (errors[result.error.code] ?? 0) + 1;",
      "      } else partial += Number(result.read.partialLine);",
      "      digest.update(JSON.stringify(result));",
      "    }",
      "  } finally { clearInterval(timer); }",
      "  const result = { algorithm: label, group, files: files.length, bodyBytes, rows, failed, errors, partial,",
      "    prepareMs, peakRssBytes: process.resourceUsage().maxRSS * 1024, peakHeapUsedBytes: peak.heapUsed,",
      "    peakArrayBufferBytes: peak.arrayBuffers, outputSha256: digest.digest('hex'),",
      "    environment: { node: process.version, v8: process.versions.v8, platform: process.platform, arch: process.arch, cpu: cpus()[0].model },",
      "    snapshotSha256: snapshot.sha256 };",
      "  process.stdout.write(JSON.stringify(result) + '\\n');",
      "}",
      "measureFiles().catch(error => { process.stderr.write(String(error.message)); process.exitCode = 1; });"
    ]
  }
