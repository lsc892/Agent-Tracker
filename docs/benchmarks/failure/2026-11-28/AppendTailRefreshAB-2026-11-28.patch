@@ -0,0 +1,59 @@
+// Stores and reuses parser state only in the isolated append benchmark.
+import type { DatabaseSync } from 'node:sqlite';
+import { readTailCheckpoints } from '../../db/benchmarkTailCache';
+import { SourceWinners } from '../../aggregation/sourceWinners';
+import type { SourceCheckpoint, SourcePreparation } from '../sourcePreparation';
+import { needsSourceRead, type FileState } from './state';
+
+export class RefreshTailCache {
+  private readonly checked = new Set<number>();
+  private readonly entries = new Map<number, SourceCheckpoint>();
+
+  constructor(private readonly connection: DatabaseSync, private readonly appendPath: string | undefined,
+    private readonly collect: boolean, private readonly maxLineBytes: number | undefined,
+    private readonly measure: <T>(action: () => T) => T) {}
+
+  load(files: readonly FileState[]): void {
+    const ids: number[] = [];
+    for (const file of files) {
+      if (!file.previous || !file.selected || this.checked.has(file.id)
+        || file.changed && file.path !== this.appendPath) continue;
+      this.checked.add(file.id);
+      ids.push(file.id);
+    }
+    if (!ids.length) return;
+    for (const [id, value] of this.measure(() => readTailCheckpoints(this.connection, ids))) {
+      const checkpoint = value as SourceCheckpoint | undefined;
+      if (checkpoint?.read?.identity && checkpoint.winners?.winners instanceof Map && checkpoint.observed
+        && checkpoint.collectCapabilities === this.collect && checkpoint.maxLineBytes === this.maxLineBytes) {
+        this.entries.set(id, checkpoint);
+      }
+    }
+  }
+
+  private matchingFile(file: FileState, entry: SourceCheckpoint): boolean {
+    return file.dev != null && file.inode != null && file.dev === entry.observed.dev && file.inode === entry.observed.inode
+      && file.previous?.mtime_ms === entry.observed.mtime;
+  }
+
+  canReuse(file: FileState): boolean {
+    const entry = this.entries.get(file.id);
+    return Boolean(entry && !file.changed && this.matchingFile(file, entry) && file.size_bytes === entry.observed.size
+      && !needsSourceRead(file, file.previous, this.collect));
+  }
+
+  reuse(file: FileState): SourcePreparation | undefined {
+    if (!this.canReuse(file)) return;
+    const { read, winners } = this.entries.get(file.id)!;
+    return { ok: true, read, winners: new SourceWinners(file.provider, winners).preparedSnapshot() };
+  }
+
+  resume(file: FileState): SourceCheckpoint | undefined {
+    if (!file.changed || file.path !== this.appendPath || file.path.toLowerCase().endsWith('.zst')) return;
+    const entry = this.entries.get(file.id);
+    const previous = file.previous;
+    if (!entry?.read.checkpoint || !previous || !this.matchingFile(file, entry) || file.size_bytes <= entry.observed.size
+      || needsSourceRead({ ...file, mtime_ms: previous.mtime_ms }, previous, this.collect)) return;
+    return entry;
+  }
+}
