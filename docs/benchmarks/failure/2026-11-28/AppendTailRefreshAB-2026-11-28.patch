diff --git a/src/summary/db/benchmarkTailCache.ts b/src/summary/db/benchmarkTailCache.ts
new file mode 100644
index 0000000..dd8dae9
--- /dev/null
+++ b/src/summary/db/benchmarkTailCache.ts
@@ -0,0 +1,56 @@
+// Stores the experimental parser checkpoints with the source rows they describe.
+import type { DatabaseSync, SQLInputValue } from 'node:sqlite';
+import { deserialize } from 'node:v8';
+
+const MAX_WRITE_ROWS = 128;
+const FILE_IDS = 'SELECT value FROM json_each(?)';
+
+export function ensureTailCheckpoints(connection: DatabaseSync): void {
+  connection.exec(`
+    CREATE TABLE IF NOT EXISTS benchmark_tail_checkpoint (
+      file_id INTEGER PRIMARY KEY REFERENCES source_file(id) ON DELETE CASCADE,
+      checkpoint BLOB NOT NULL
+    ) STRICT;
+    CREATE TRIGGER IF NOT EXISTS benchmark_tail_checkpoint_source_missing
+      AFTER UPDATE OF source_missing ON source_file WHEN new.source_missing = 1
+    BEGIN
+      DELETE FROM benchmark_tail_checkpoint WHERE file_id = new.id;
+    END;
+  `);
+}
+
+export function readTailCheckpoints(connection: DatabaseSync, ids: readonly number[]): Map<number, unknown> {
+  const checkpoints = new Map<number, unknown>();
+  if (!ids.length) return checkpoints;
+  const rows = connection.prepare(`SELECT file_id, checkpoint FROM benchmark_tail_checkpoint
+    WHERE file_id IN (${FILE_IDS})`).iterate(JSON.stringify(ids));
+  for (const row of rows) {
+    if (typeof row.file_id !== 'number' || !(row.checkpoint instanceof Uint8Array)) continue;
+    try {
+      checkpoints.set(row.file_id, deserialize(row.checkpoint));
+    } catch {
+      // An unreadable checkpoint is a cache miss. The scanner can parse the source again.
+    }
+  }
+  return checkpoints;
+}
+
+/** Must run inside the transaction that commits source rows and usage. An absent value erases a checkpoint. */
+export function writeTailCheckpoints(connection: DatabaseSync, checkpoints: ReadonlyMap<number, Uint8Array | undefined>): void {
+  const rows = [], erased: number[] = [];
+  for (const [fileId, value] of checkpoints) {
+    if (value === undefined) erased.push(fileId);
+    else rows.push([fileId, value] as const);
+  }
+  if (erased.length) {
+    connection.prepare(`DELETE FROM benchmark_tail_checkpoint WHERE file_id IN (${FILE_IDS})`).run(JSON.stringify(erased));
+  }
+  for (let offset = 0; offset < rows.length; offset += MAX_WRITE_ROWS) {
+    const batch = rows.slice(offset, offset + MAX_WRITE_ROWS);
+    const parameters: SQLInputValue[] = [];
+    for (const [fileId, value] of batch) parameters.push(fileId, value);
+    const placeholders = batch.map(() => '(?, ?)').join(', ');
+    connection.prepare(`INSERT INTO benchmark_tail_checkpoint(file_id, checkpoint) VALUES ${placeholders}
+      ON CONFLICT(file_id) DO UPDATE SET checkpoint = excluded.checkpoint`).run(...parameters);
+  }
+}
